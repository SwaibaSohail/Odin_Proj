<%- include("../partials/header") %>
        <nav class="breadcrumbs"><a href="/">Categories</a> / <span><%= category.name %></span></nav>

        <section class="page-head">
            <div>
                <h1><%= category.name %></h1>
                <% if (category.description) { %><p class="muted"><%= category.description %></p><% } %>
            </div>
            <div class="actions">
                <a href="/items/new?category=<%= category.id %>" class="btn btn-primary">+ Add Item</a>
                <a href="/categories/<%= category.id %>/edit" class="btn btn-secondary">Edit</a>
                <a href="/categories/<%= category.id %>/delete" class="btn btn-danger">Delete</a>
            </div>
        </section>

        <% if (items.length === 0) { %>
            <div class="empty">
                No items in this category yet.
                <a href="/items/new?category=<%= category.id %>">Add the first one</a>.
            </div>
        <% } else { %>
            <%- include("../partials/itemTable", { items, showCategory: false }) %>
        <% } %>
<%- include("../partials/footer") %>
