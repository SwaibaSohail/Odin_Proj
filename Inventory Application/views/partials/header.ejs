<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> · Riff &amp; Rhythm Inventory</title>
    <script>
        // Apply the saved theme before the page paints to avoid a flash.
        try {
            const savedTheme = localStorage.getItem("theme");
            if (savedTheme) document.documentElement.dataset.theme = savedTheme;
        } catch (e) {}
    </script>
    <link rel="stylesheet" href="/styles.css">
    <script src="/theme.js" defer></script>
</head>

<body>
    <header class="site-header">
        <a href="/" class="logo">Riff &amp; Rhythm <span class="logo-tag">Inventory</span></a>
        <nav class="site-nav">
            <a href="/">Categories</a>
            <a href="/items">All Items</a>
            <button type="button" class="theme-toggle" aria-label="Toggle dark mode">Dark</button>
        </nav>
    </header>
