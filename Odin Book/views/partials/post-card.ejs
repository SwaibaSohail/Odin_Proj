<article class="post card" id="post-<%= post.id %>">
    <header class="post-head">
        <a class="post-face" href="/users/<%= post.author.username %>" tabindex="-1" aria-hidden="true"><%- include("avatar", { user: post.author, size: 44 }) %></a>
        <div class="post-who">
            <a class="post-author" href="/users/<%= post.author.username %>"><%= post.author.displayName %></a>
            <p class="post-meta">@<%= post.author.username %> · <a href="/posts/<%= post.id %>"><time datetime="<%= post.createdAt.toISOString() %>" title="<%= h.exactTime(post.createdAt) %>"><%= h.timeAgo(post.createdAt) %></time></a></p>
        </div>
        <% if (post.author.id === me.id) { %>
        <form method="post" action="/posts/<%= post.id %>/delete" data-confirm="Delete this post? Its comments and likes go too.">
            <input type="hidden" name="next" value="<%= here %>">
            <button type="submit" class="link-button danger">Delete</button>
        </form>
        <% } %>
    </header>

    <% if (post.body) { %><p class="post-body"><%- h.linkify(post.body) %></p><% } %>
    <% if (post.image) { %>
    <a class="post-image" href="<%= full ? `/images/${post.image.id}` : `/posts/${post.id}` %>"<%- full ? ' target="_blank" rel="noopener"' : "" %>>
        <img src="/images/<%= post.image.id %>" width="<%= post.image.width %>" height="<%= post.image.height %>" alt="Picture posted by <%= post.author.displayName %>" loading="lazy">
    </a>
    <% } %>

    <footer class="post-actions">
        <form method="post" action="/posts/<%= post.id %>/<%= post.liked ? "unlike" : "like" %>" data-like="<%= post.id %>">
            <input type="hidden" name="next" value="<%= here %>#post-<%= post.id %>">
            <button type="submit" class="action<%= post.liked ? " liked" : "" %>" aria-pressed="<%= post.liked %>" title="<%= post.liked ? "Unlike" : "Like" %>">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.7c0 5.6-7.5 10.2-7.5 10.2Z"/></svg>
                <span data-like-count><%= post.likeCount %></span><span class="visually-hidden"> likes</span>
            </button>
        </form>
        <a class="action" href="/posts/<%= post.id %>#comments" title="Comments">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5.5h14a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5h-7l-4.5 3.5v-3.5H5A1.5 1.5 0 0 1 3.5 16V7A1.5 1.5 0 0 1 5 5.5Z"/></svg>
            <span><%= post.commentCount %></span><span class="visually-hidden"> comments</span>
        </a>
    </footer>

    <section class="comments" id="<%= full ? "comments" : `comments-${post.id}` %>" aria-label="Comments">
        <% if (!full && post.commentCount > post.comments.length) { %>
        <a class="more-comments" href="/posts/<%= post.id %>#comments">View all <%= post.commentCount %> comments</a>
        <% } %>
        <% if (post.comments.length) { %>
        <ul class="comment-list">
            <% for (const comment of post.comments) { %>
            <li class="comment">
                <a href="/users/<%= comment.author.username %>" tabindex="-1" aria-hidden="true"><%- include("avatar", { user: comment.author, size: 28 }) %></a>
                <div class="comment-bubble">
                    <p class="comment-head">
                        <a class="comment-author" href="/users/<%= comment.author.username %>"><%= comment.author.displayName %></a>
                        <time datetime="<%= comment.createdAt.toISOString() %>" title="<%= h.exactTime(comment.createdAt) %>"><%= h.timeAgo(comment.createdAt) %></time>
                        <% if (comment.author.id === me.id || post.author.id === me.id) { %>
                        <form method="post" action="/comments/<%= comment.id %>/delete" data-confirm="Delete this comment?">
                            <input type="hidden" name="next" value="<%= here %>#post-<%= post.id %>">
                            <button type="submit" class="link-button danger">Delete</button>
                        </form>
                        <% } %>
                    </p>
                    <p class="comment-body"><%- h.linkify(comment.body) %></p>
                </div>
            </li>
            <% } %>
        </ul>
        <% } else if (full) { %>
        <p class="muted no-comments">No comments yet.</p>
        <% } %>
        <form method="post" action="/posts/<%= post.id %>/comments" class="comment-form">
            <input type="hidden" name="next" value="<%= here %>#post-<%= post.id %>">
            <%- include("avatar", { user: me, size: 28 }) %>
            <input name="body" maxlength="500" placeholder="Write a comment" aria-label="Write a comment on this post" autocomplete="off" required>
            <button type="submit" class="btn btn-small">Comment</button>
        </form>
    </section>
</article>
