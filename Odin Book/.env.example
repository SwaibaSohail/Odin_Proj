# Copy this file to .env and fill in your own values.
DATABASE_URL=postgresql://hearth_user:hearth_pass@localhost:5432/odin_book

# A long random string used to sign session cookies. Make one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

PORT=3000

# Optional: password for the sample accounts created by "npm run seed".
# Leave it out on a live site and they get random passwords nobody knows.
SEED_PASSWORD=hearth123
