# Copy this file to .env and fill in your own values.
DATABASE_URL=postgresql://parley_user:parley_pass@localhost:5432/messaging_app

# A long random string used to sign log-in cookies. Make one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

PORT=3000

# Optional: password for the demo accounts created by "npm run seed".
# Leave it out on a live site and the demo accounts get random passwords nobody knows.
SEED_PASSWORD=parley123
