# Copy this file to .env and fill in your own values.
DATABASE_URL=postgresql://blog_user:blog_pass@localhost:5432/blog_api
JWT_SECRET=replace-this-with-a-long-random-string
PORT=3000

# Websites allowed to call the API, separated by commas.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional: password for the author account created by "npm run seed" (default: notebook123)
# SEED_PASSWORD=
