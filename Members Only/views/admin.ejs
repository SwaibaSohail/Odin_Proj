<%- include("partials/header") %>
        <div class="form-card form-card-narrow">
            <h1>Admin access</h1>

            <% if (currentUser.is_admin) { %>
                <p>You're already an admin. <a href="/">Back to the board</a></p>
            <% } else { %>
                <p class="muted">Admins can see everything and delete messages. Enter the admin passcode to become one.</p>
                <%- include("partials/errors") %>

                <form method="POST" action="/admin" class="form">
                    <label for="passcode">Admin passcode</label>
                    <input type="password" id="passcode" name="passcode" autocomplete="off" required>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Become an admin</button>
                        <a href="/" class="btn btn-ghost">Cancel</a>
                    </div>
                </form>
            <% } %>
        </div>
<%- include("partials/footer") %>
