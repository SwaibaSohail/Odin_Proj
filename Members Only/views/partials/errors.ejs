<% if (locals.errors && errors.length > 0) { %>
    <div class="alert alert-error" role="alert">
        <% if (errors.length === 1) { %>
            <%= errors[0].msg %>
        <% } else { %>
            <ul>
                <% errors.forEach((error) => { %>
                    <li><%= error.msg %></li>
                <% }) %>
            </ul>
        <% } %>
    </div>
<% } %>
