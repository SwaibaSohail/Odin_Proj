<%- include("partials/header") %>
        <div class="form-card form-card-narrow center">
            <h1>This link has expired</h1>
            <p>
                The share link for "<%= link.folder.name %>" stopped working on
                <time class="local-time" datetime="<%= link.expiresAt.toISOString() %>"><%= formatDate(link.expiresAt) %></time>.
                Ask <%= link.folder.owner.name %> for a new one.
            </p>
        </div>
<%- include("partials/footer") %>
