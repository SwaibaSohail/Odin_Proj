# Copy this file to .env and fill in your own values.
DATABASE_URL=postgresql://uploader_user:uploader_pass@localhost:5432/file_uploader
SESSION_SECRET=replace-this-with-a-long-random-string
PORT=3000

# Where uploaded files are stored: "local" (the uploads folder) or "supabase".
STORAGE_DRIVER=local

# Only needed when STORAGE_DRIVER=supabase. Keep the service role key secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=files
